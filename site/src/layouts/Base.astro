---
import '../styles/global.css';
import { formatDate } from '../lib/format';
import { site } from '../lib/site-data';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const model = site.index.model;
// Chromium prerenders every event page up front (there are only a handful), so tile taps feel instant
// on phones too, where there is no hover to warn it.
const SPECULATION_RULES = JSON.stringify({
  prerender: [{ where: { href_matches: '/events/*' }, eagerness: 'eager' }],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script type="speculationrules" is:inline set:html={SPECULATION_RULES} />
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <p>
        {model ? `Finish model as of ${formatDate(model.as_of)}` : 'Finish model not yet available'}.
        High / Medium / Low is the model's chance the fight ends inside the distance; — means too little data.
      </p>
      <p>
        Elo rates fighters from their results, weighted by opponent strength; 1500 is the average active fighter.
        provisional means fewer than 3 UFC fights; inactive means no fight in the last 12 months. Peak and best win are under
        Stats.
      </p>
      <p><a href="/how-it-works/">How finish chance and Elo work</a></p>
      <p>Data: <a href="http://ufcstats.com">ufcstats.com</a>. Headshots: ESPN, Wikipedia. Not affiliated with the UFC.</p>
    </footer>
  </body>
</html>
