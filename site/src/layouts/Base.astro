---
import '../styles/global.css';
import { formatDate } from '../lib/format';
import { SITE_NAME, jsonLdScript } from '../lib/seo';
import { site } from '../lib/site-data';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** schema.org objects, one <script type="application/ld+json"> each */
  jsonLd?: object[];
  /** Error pages: keep out of search and give them no canonical URL. */
  noindex?: boolean;
}

const { title, description, ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
const canonical = noindex ? null : new URL(Astro.url.pathname, Astro.site).href;
const model = site.index.model;
const onRankings = Astro.url.pathname === '/rankings/';
// Chromium prerenders every event page up front (there are only a handful), so tile taps feel instant
// on phones too, where there is no hover to warn it.
const SPECULATION_RULES = JSON.stringify({
  prerender: [{ where: { href_matches: '/events/*' }, eagerness: 'eager' }],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={jsonLdScript(data)} />)}
    <!-- Drawn by scripts/build-icons.mjs from the accent token -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
    <script type="speculationrules" is:inline set:html={SPECULATION_RULES} />
  </head>
  <body>
    {
      site.rankings && (
        <nav class="site-nav" aria-label="Site">
          <a href="/" aria-current={onRankings ? undefined : 'true'}>Fight cards</a>
          <a href="/rankings/" aria-current={onRankings ? 'page' : undefined}>Rankings</a>
        </nav>
      )
    }
    <slot />
    <footer class="site-footer">
      <p>
        {model ? `Finish model as of ${formatDate(model.as_of)}` : 'Finish model not yet available'}.
        High / Medium / Low is the model's chance the fight ends inside the distance; — means too little data.
      </p>
      <p>
        Elo rates fighters from their results, weighted by opponent strength; 1500 is the average active fighter.
        provisional means fewer than 3 UFC fights; inactive means no fight in the last 12 months. Peak and best win are under
        Stats.
      </p>
      <p><a href="/how-it-works/">How finish chance and Elo work</a></p>
      <p>Data: <a href="http://ufcstats.com">ufcstats.com</a>. Headshots: ESPN, Wikipedia. Not affiliated with the UFC.</p>
    </footer>
  </body>
</html>
