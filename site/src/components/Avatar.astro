---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { initials } from '../lib/format';
import type { Fighter } from '../lib/schema';

interface Props {
  fighter: Fighter;
}

const { fighter } = Astro.props;

// Headshots live in DATA_DIR/images (aliased as @data); keys are matched by suffix.
const images = import.meta.glob<{ default: ImageMetadata }>('@data/images/*.{png,jpg,jpeg,webp}');
const key = fighter.image && Object.keys(images).find((k) => k.endsWith(`/${fighter.image}`));
const src = key ? (await images[key]!()).default : undefined;
---

{
  src ? (
    <Picture
      class="avatar"
      src={src}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      width={48}
      height={48}
      densities={[1, 2]}
      fit="cover"
      position="top"
      alt=""
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span class="avatar" data-testid="avatar-initials" aria-hidden="true">
      {initials(fighter.name)}
    </span>
  )
}
