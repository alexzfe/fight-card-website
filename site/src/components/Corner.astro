---
import Avatar from './Avatar.astro';
import { eloTags, eloTip, formatElo, formatPastFight, formatRecord, resultLetter, tagTip } from '../lib/format';
import { rankingsHref } from '../lib/rankings';
import type { Fighter } from '../lib/schema';
import { site } from '../lib/site-data';

interface Props {
  side: 'red' | 'blue';
  fighter: Fighter;
  winner: boolean;
  eager?: boolean;
  large?: boolean;
}

const { side, fighter, winner, eager, large } = Astro.props;
const form = fighter.recent_fights ?? [];
const elo = formatElo(fighter.elo);
const p4p = fighter.p4p_rank != null ? `#${fighter.p4p_rank} P4P` : null;
const p4pHref = p4p && rankingsHref(site.rankings, fighter.id);
const tags = eloTags(fighter);
const eloHint = eloTip(fighter);
const tip = (f: (typeof form)[number]) => [f.opponent, formatPastFight(f)].filter(Boolean).join(' · ');
---

<div class:list={['corner', `corner-${side}`, { winner }]} data-testid={winner ? 'winner' : undefined}>
  {/* Sized for the widest layout; CSS shrinks it on phones. */}
  <Avatar fighter={fighter} eager={eager} size={large ? 96 : 72} />
  <div class="who">
    <span class="name">{fighter.name}</span>
    <span class="record">{formatRecord(fighter.record)}</span>
    {
      elo && (
        <span class="elo-line">
          {/* Tips show on hover or tap (tabindex -1 lets a tap focus them); Stats lists the same peak and best win. */}
          <span class="elo" data-testid="elo" data-tip={eloHint} tabindex={eloHint ? '-1' : undefined}>
            {elo}
            {/* The rank links to the fighter's row in the rankings; it sits inside the Elo, so hovering it still shows the tip. */}
            {p4p && <> · {p4pHref ? <a class="elo-rank" href={p4pHref}>{p4p}</a> : p4p}</>}
          </span>
          {tags.map((t) => (
            <span class="elo-tag" data-testid="elo-tag" data-tip={tagTip(t)} tabindex="-1">
              {t}
            </span>
          ))}
        </span>
      )
    }
    {
      form.length > 0 && (
        <span class="form" data-testid="form" aria-label={`Last ${form.length}: ${form.map((f) => f.result).join(', ')}`}>
          {form.map((f, i) => (
            <>
              {i > 0 && ' '}
              {/* tabindex -1: a tap focuses the tile to show its tip, without adding Tab stops (Stats lists the same fights). */}
              <span class={`form-${f.result}`} data-tip={tip(f)} tabindex="-1">
                {resultLetter(f.result)}
              </span>
            </>
          ))}
        </span>
      )
    }
    {winner && <span class="sr-only">(winner)</span>}
  </div>
</div>
