---
import FightRow from './FightRow.astro';
import LivePoll from './LivePoll.astro';
import { groupBySegment, segmentLabel } from '../lib/card';
import { cardPhase, carriesLivePoll } from '../lib/events';
import { formatLongDate, splitEventName } from '../lib/format';
import type { Event, Fighter } from '../lib/schema';
import { buildNow, site } from '../lib/site-data';

interface Props {
  event: Event;
  fighters: { [id: string]: Fighter };
}

const { event, fighters } = Astro.props;
// Rows visible on a phone's first screen load their photos eagerly.
const EAGER_ROWS = 3;
const meta = [formatLongDate(event.date), event.location].filter(Boolean).join(' · ');
// "Live" while the card is running at build time, "Results" once it's done; the live script keeps it current.
const phase = cardPhase(event, buildNow);
const status = phase ? ` · ${phase === 'live' ? 'Live' : 'Results'}` : '';
const live = carriesLivePoll(event, buildNow);
// The colon stays in the text (visually hidden) so the heading still reads as the full event name.
const { kicker, headline } = splitEventName(event.name);
const groups = groupBySegment(event.fights);
const labelled = groups.some((g) => g.segment);
const indexOf = new Map(event.fights.map((f, i) => [f.id, i]));
---

<header class="page-head">
  <h1>
    {kicker && <span class="kicker">{kicker}<span class="sr-only">:</span> </span>}
    <span class="headline">{headline}</span>
  </h1>
  <p class="event-meta">{meta}<span data-event-status>{status}</span></p>
  {live && <p class="live-line" data-testid="live-line" data-live-line hidden />}
</header>
{live && <LivePoll event={event} fighters={fighters} since={site.index.generated_at} />}
{
  event.fights.length ? (
    groups.map((group) => (
      <section class="segment" data-testid={labelled ? 'segment' : undefined}>
        {labelled && (
          <h2 class="segment-head">
            <span>{group.segment ? segmentLabel(group.segment) : 'Other bouts'}</span>{' '}
            <span class="segment-count">
              {group.fights.length} {group.fights.length === 1 ? 'fight' : 'fights'}
            </span>
          </h2>
        )}
        <ul class="fights">
          {group.fights.map((fight, j) => {
            const i = indexOf.get(fight.id)!;
            return (
              <FightRow
                fight={fight}
                event={event}
                fighters={fighters}
                eager={i < EAGER_ROWS}
                mainEvent={i === 0}
                finishLabel={j === 0}
              />
            );
          })}
        </ul>
      </section>
    ))
  ) : (
    <p class="empty">No fights announced yet.</p>
  )
}
