---
import Corner from './Corner.astro';
import TierBadge from './TierBadge.astro';
import {
  ageAt,
  formatBestWin,
  formatHeight,
  formatPastFight,
  formatReach,
  formatResult,
  resultLetter,
} from '../lib/format';
import type { Event, Fight, Fighter } from '../lib/schema';

interface Props {
  fight: Fight;
  event: Event;
  fighters: { [id: string]: Fighter };
  eager?: boolean;
  /** First fight on the card: bigger headshots and a "Main event" marker. */
  mainEvent?: boolean;
}

const { fight, event, fighters, eager, mainEvent = false } = Astro.props;
const red = fighters[fight.red]!;
const blue = fighters[fight.blue]!;
const result = formatResult(fight.result);
const winner = fight.result?.winner;
const age = (f: Fighter) => ageAt(f.dob, event.date) ?? '—';
const stats = [
  ['Height', formatHeight(red.height_in), formatHeight(blue.height_in)],
  ['Reach', formatReach(red.reach_in), formatReach(blue.reach_in)],
  ['Stance', red.stance ?? '—', blue.stance ?? '—'],
  ['Age', age(red), age(blue)],
] as const;
// Elo detail lives in Stats; the corner shows only the current rating. A row shows when either side has a value.
const rating = (f: Fighter) =>
  f.elo == null ? null : [f.elo, f.p4p_rank != null ? `#${f.p4p_rank} P4P` : null].filter(Boolean).join(' · ');
const eloRows = [
  ['Elo', rating(red), rating(blue)],
  ['Peak', red.elo_peak, blue.elo_peak],
].filter(([, r, b]) => r != null || b != null);
const bestWins = [formatBestWin(red.best_win), formatBestWin(blue.best_win)] as const;
const history = [red, blue].map((f) => f.recent_fights ?? []);
---

<li class:list={['fight', { done: result, 'main-event': mainEvent }]} data-testid="fight">
  <div class="bout">
    <Corner side="red" fighter={red} winner={winner === red.id} eager={eager} large={mainEvent} />
    <div class="mid">
      {mainEvent && <span class="main-event-marker" data-testid="main-event">Main event</span>}
      {fight.weight_class && <span>{fight.weight_class}</span>}
      {fight.title_fight && <span class="title-marker" data-testid="title">Title</span>}
      <span class="finish-label" data-testid="finish-label">Finish chance</span>
      {
        result ? (
          <span class="outcome" data-testid="outcome">
            <TierBadge tier={fight.finish_tier} />{' '}
            <span class="result">→ {result}</span>
          </span>
        ) : (
          <TierBadge tier={fight.finish_tier} />
        )
      }
    </div>
    <Corner side="blue" fighter={blue} winner={winner === blue.id} eager={eager} large={mainEvent} />
  </div>
  <details class="stats">
    <summary>Stats</summary>
    <table>
      <tbody>
        {
          stats.map(([label, r, b]) => (
            <tr>
              <td>{r}</td>
              <th scope="row">{label}</th>
              <td>{b}</td>
            </tr>
          ))
        }
        {
          eloRows.map(([label, r, b]) => (
            <tr>
              <td>{r ?? '—'}</td>
              <th scope="row">{label}</th>
              <td>{b ?? '—'}</td>
            </tr>
          ))
        }
        {
          bestWins.some(Boolean) && (
            <tr>
              <td>
                {bestWins[0] ? (
                  <>
                    {bestWins[0].opponent}
                    <span class="best-win-meta">{bestWins[0].meta}</span>
                  </>
                ) : (
                  '—'
                )}
              </td>
              <th scope="row">Best win</th>
              <td>
                {bestWins[1] ? (
                  <>
                    {bestWins[1].opponent}
                    <span class="best-win-meta">{bestWins[1].meta}</span>
                  </>
                ) : (
                  '—'
                )}
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
    {
      history.some((h) => h.length > 0) && (
        <div class="last-fights">
          {history.map((fights, i) => (
            <div class:list={['last-fights-side', i === 0 ? 'side-red' : 'side-blue']}>
              {fights.length > 0 && (
                <ol data-testid="last-fights" aria-label={`${[red, blue][i]!.name}: last ${fights.length} fights`}>
                  {fights.map((f) => (
                    <li>
                      <span class:list={['past-result', `form-${f.result}`]}>{resultLetter(f.result)}</span>{' '}
                      <span class="past-opponent">{f.opponent}</span>
                      <span class="past-meta">{formatPastFight(f)}</span>
                    </li>
                  ))}
                </ol>
              )}
            </div>
          ))}
        </div>
      )
    }
  </details>
</li>
