---
import Corner from './Corner.astro';
import TierBadge from './TierBadge.astro';
import {
  ageAt,
  eloAtFight,
  formatBestWin,
  formatHeight,
  formatPastFight,
  formatReach,
  resultLetter,
  resultParts,
} from '../lib/format';
import type { Event, Fight, Fighter } from '../lib/schema';

interface Props {
  fight: Fight;
  event: Event;
  fighters: { [id: string]: Fighter };
  eager?: boolean;
  /** First fight on the card: bigger headshots and a "Main event" marker. */
  mainEvent?: boolean;
  /** First fight of its segment: the "Finish chance" label shows; on the rows below it only screen readers get it. */
  finishLabel?: boolean;
}

const { fight, event, fighters, eager, mainEvent = false, finishLabel = false } = Astro.props;
const red = fighters[fight.red]!;
const blue = fighters[fight.blue]!;
// Completed once there is a result, even one known only by its winner (resultParts is then null: no outcome block).
const done = fight.result != null;
const result = resultParts(fight.result);
const winner = fight.result?.winner;
const age = (f: Fighter) => ageAt(f.dob, event.date) ?? '—';
const stats = [
  ['Height', formatHeight(red.height_in), formatHeight(blue.height_in)],
  ['Reach', formatReach(red.reach_in), formatReach(blue.reach_in)],
  ['Stance', red.stance ?? '—', blue.stance ?? '—'],
  ['Age', age(red), age(blue)],
] as const;
// The corner shows the Elo (going in, on a completed fight with fight.elo); Stats adds today's peak, when either side has one.
const eloRows = [['Peak', red.elo_peak, blue.elo_peak]].filter(([, r, b]) => r != null || b != null);
const bestWins = [formatBestWin(red.best_win), formatBestWin(blue.best_win)] as const;
// The last fights, as tiles and in Stats: an upcoming fight shows today's; a completed one the form going into it
// (contract 1.4), never today's, which would count the fights after it; none without it.
const formAt = (side: 'red' | 'blue', f: Fighter) => (done ? (fight.form?.[side] ?? []) : (f.recent_fights ?? []));
const redForm = formAt('red', red);
const blueForm = formAt('blue', blue);
const history = [redForm, blueForm];
---

<li class:list={['fight', { done, 'main-event': mainEvent }]} data-testid="fight">
  <div class="bout">
    <Corner side="red" fighter={red} winner={winner === red.id} lost={!!winner && winner !== red.id} form={redForm} eager={eager} large={mainEvent} atFight={eloAtFight(fight, 'red')} />
    <div class="mid">
      {mainEvent && <span class="main-event-marker" data-testid="main-event">Main event</span>}
      {/* A completed fight leads with how it ended; the pre-fight badge, frozen at the start, stays below when there was one. */}
      {
        result && (
          <span class="outcome" data-testid="outcome">
            {result.method && <span class="method">{result.method}</span>}
            {result.method && result.when && ' '}
            {result.when && <span class="when">{result.when}</span>}
          </span>
        )
      }
      {fight.weight_class && <span>{fight.weight_class}</span>}
      {fight.title_fight && <span class="title-marker" data-testid="title">Title</span>}
      {
        (!done || fight.finish_tier) && (
          <>
            <span class:list={['finish-label', { 'sr-only': !finishLabel }]} data-testid="finish-label">Finish chance</span>
            <TierBadge tier={fight.finish_tier} />
          </>
        )
      }
    </div>
    <Corner side="blue" fighter={blue} winner={winner === blue.id} lost={!!winner && winner !== blue.id} form={blueForm} eager={eager} large={mainEvent} atFight={eloAtFight(fight, 'blue')} />
  </div>
  <details class="stats">
    <summary>Stats</summary>
    <table>
      <tbody>
        {
          stats.map(([label, r, b]) => (
            <tr>
              <td>{r}</td>
              <th scope="row">{label}</th>
              <td>{b}</td>
            </tr>
          ))
        }
        {
          eloRows.map(([label, r, b]) => (
            <tr>
              <td>{r ?? '—'}</td>
              <th scope="row">{label}</th>
              <td>{b ?? '—'}</td>
            </tr>
          ))
        }
        {
          bestWins.some(Boolean) && (
            <tr>
              <td>
                {bestWins[0] ? (
                  <>
                    {bestWins[0].opponent}
                    <span class="best-win-meta">{bestWins[0].meta}</span>
                  </>
                ) : (
                  '—'
                )}
              </td>
              <th scope="row">Best win</th>
              <td>
                {bestWins[1] ? (
                  <>
                    {bestWins[1].opponent}
                    <span class="best-win-meta">{bestWins[1].meta}</span>
                  </>
                ) : (
                  '—'
                )}
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
    {
      history.some((h) => h.length > 0) && (
        <div class="last-fights">
          {history.map((fights, i) => (
            <div class:list={['last-fights-side', i === 0 ? 'side-red' : 'side-blue']}>
              {fights.length > 0 && (
                <ol data-testid="last-fights" aria-label={`${[red, blue][i]!.name}: last ${fights.length} fights`}>
                  {fights.map((f) => (
                    <li>
                      <span class:list={['past-result', `form-${f.result}`]}>{resultLetter(f.result)}</span>{' '}
                      <span class="past-opponent">{f.opponent}</span>
                      <span class="past-meta">{formatPastFight(f)}</span>
                    </li>
                  ))}
                </ol>
              )}
            </div>
          ))}
        </div>
      )
    }
  </details>
</li>
