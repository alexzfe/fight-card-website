---
import { byDateAscending } from '../lib/events';
import { eventTile } from '../lib/format';
import type { Event } from '../lib/schema';
import { site } from '../lib/site-data';

interface Props {
  events: Event[];
  current: Event | undefined;
}

const { events, current } = Astro.props;
// The Rankings tile is pinned at the rail's right end (the events scroll beside it), only when there is a rankings page.
// Its wording lives here alone; the podium icon tells it apart from the event tiles.
const RANKINGS_LABEL = 'Rankings';
const onRankings = Astro.url.pathname === '/rankings/';
const rail = byDateAscending(events);
// The today marker goes before the first upcoming event, when there are past events to its left.
const firstUpcoming = rail.findIndex((e) => e.status === 'upcoming');
// The inline script below ships unminified under a size budget (tests/build), so its notes live here.
// - The rail stays where the visitor left it across event pages (sessionStorage), applied at pagereveal so prerendered
//   pages pick up the latest position.
// - With no saved position it opens on what's next: it centres the furthest upcoming tile that still leaves the latest
//   past tile clear of the left fade (on a phone, just the first upcoming one). The list keeps growing leftwards.
// - The selected tile is centred whenever it sits under an edge fade (1rem left, 2.5rem right, as .rail's mask).
// - Tabbing to a tile centres it: the scroll that focus does by itself gets pulled back by the mandatory snap,
//   leaving the focused tile under the edge fade. Keyboard focus only, so a tap doesn't scroll mid-navigation.
---

<nav class="rail-nav" aria-label={site.rankings ? 'Events and rankings' : 'Events'}>
  <ul class="rail">
    {
      rail.map((e, i) => {
        const tile = eventTile(e);
        return (
          <>
            {i > 0 && i === firstUpcoming && <li class="rail-today" data-testid="rail-today" aria-hidden="true" />}
            <li>
              <a
                class:list={['tile', { 'tile-past': e.status === 'completed' }]}
                data-testid="event-tile"
                href={`/events/${e.slug}/`}
                aria-current={e.id === current?.id ? 'page' : undefined}
                title={e.name}
              >
                <span class="tile-meta">{tile.meta}</span>
                <span class="tile-headline">{tile.headline}</span>
              </a>
            </li>
          </>
        );
      })
    }
  </ul>
  {
    site.rankings && (
      <a href="/rankings/" class="tile tile-pin" aria-current={onRankings ? 'page' : undefined}>
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
          <path d="M1.5 16.5v-7h5v-6h5v8h5v5zM6.5 9.5v7m5-5v5" />
        </svg>
        {RANKINGS_LABEL}
      </a>
    )
  }
</nav>
<script is:inline>
  (() => {
    const rail = document.querySelector('.rail');
    const save = () => {
      try { sessionStorage.setItem('event-rail-scroll', rail.scrollLeft); } catch {}
    };
    const box = (e) => e.getBoundingClientRect();
    const shift = (e, r = box(rail)) => box(e).left + box(e).width / 2 - r.left - r.width / 2;
    const place = () => {
      let at, to;
      try { at = sessionStorage.getItem('event-rail-scroll'); } catch {}
      const today = rail.querySelector('.rail-today');
      if (at != null) rail.scrollLeft = at;
      else if (today) {
        const past = box(today.previousElementSibling).left - 16 - box(rail).left;
        for (let li = today.nextElementSibling; li && (to == null || shift(li) <= past); li = li.nextElementSibling)
          to = shift(li);
        rail.scrollLeft += to;
      }
      const t = rail.querySelector('[aria-current="page"]'), b = t && box(t);
      if (b && (b.left < box(rail).left + 16 || b.right > box(rail).right - 40)) rail.scrollLeft += shift(t);
    };
    rail.addEventListener('focusin', ({ target: t }) => {
      const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
      if (t.matches(':focus-visible')) t.scrollIntoView({ inline: 'center', block: 'nearest', behavior });
    });
    rail.addEventListener('click', save);
    addEventListener('pagehide', save);
    if ('onpagereveal' in window) addEventListener('pagereveal', place, { once: true });
    else place();
  })();
</script>
