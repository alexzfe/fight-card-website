---
import Base from '../layouts/Base.astro';
import EventRail from '../components/EventRail.astro';
import EventCard from '../components/EventCard.astro';
import { currentEvent } from '../lib/events';
import { SITE_NAME, eventJsonLd, homeDescription, homeTitle } from '../lib/seo';
import { buildNow, site } from '../lib/site-data';

const event = currentEvent(site.events, buildNow);
const jsonLd: object[] = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: Astro.site!.href }];
if (event) jsonLd.push(eventJsonLd(event, site.fighters, new URL(`/events/${event.slug}/`, Astro.site).href));
---

<Base title={homeTitle(event)} description={homeDescription(event)} jsonLd={jsonLd} page="card">
  <EventRail events={site.events} current={event} />
  <main>
    {event ? <EventCard event={event} fighters={site.fighters} /> : <p class="empty">No events scheduled.</p>}
  </main>
</Base>
